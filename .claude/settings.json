{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 480,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-invariants.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/harden-runtime-perms.sh"
          }
        ]
      }
    ]
  }
}
