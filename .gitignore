# Sensitive tax data — never commit
taxpayer_profile.json
tax_law_*.json
result.json
answers.md
summaries/
documents/*
!documents/.gitkeep
FBAR_*.md
*.pdf
projections/
projection_inputs.json
scenarios/
reviews/
# Year-end cutover moves documents/ and reviews/ BENEATH archive/{year}/,
# where the root-scoped rules above no longer reach them.
archive/
holdings.json
parse_ledger.json
crypto_transactions.json
tax_calendar_*.ics

# Python bytecode
__pycache__/
*.pyc

# Virtual environment
.venv/

# Environment files (may contain API keys)
.env
.env.*
.env.local

# Editor swap/backup files (may contain partial copies of sensitive data)
*.swp
*.swo
*~
*.bak
*.tmp

# OS artifacts
.DS_Store
Thumbs.db

# IDE files
# Exclude .vscode CONTENTS rather than the directory: git never descends into an
# excluded directory, so a negation under `.vscode/` would silently do nothing.
# settings.json is checked in — it is what makes Copilot find .agents/skills.
.vscode/*
!.vscode/settings.json
.idea/

# Hookify local rules (machine-specific, not for sharing)
.claude/*.local.md
